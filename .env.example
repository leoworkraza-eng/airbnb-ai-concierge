# ---------------------------------------------------------------------------
# Airbnb AI Concierge — environment variables
# Copy this file to `.env.local` and fill in the values. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Claude (required for the AI Concierge) ---------------------------------
# Create a key at https://console.anthropic.com/ (server-side only).
ANTHROPIC_API_KEY=
# Configurable so a newer model can be adopted without code changes.
CLAUDE_MODEL=claude-sonnet-5-5
# Optional: cap output tokens per concierge reply.
CLAUDE_MAX_TOKENS=1200

# --- Supabase (required for persistent production storage + host auth) ------
# Supabase → Project Settings → API. All four are server-side only in this app.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key bypasses RLS. Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_wYm9aUdXoot1hCiXrQ2tGw_Dwq5FzLr

# --- Session signing --------------------------------------------------------
# Random 32+ character string used to sign guest and host session cookies.
SESSION_SECRET=

# --- Optional: demo host account -------------------------------------------
# Used only when Supabase is not configured (local file store).
DEMO_HOST_EMAIL=host@casabarcelona.demo
DEMO_HOST_PASSWORD=Concierge2026

# --- Optional: pin the guest demo to a property ----------------------------
# DEMO_PROPERTY_ID=

# --- Optional: Google Places (live nearby recommendations) -----------------
# When set, the concierge can query real nearby venues. Without it, the
# clearly-labelled curated dataset is used instead.
GOOGLE_MAPS_API_KEY=

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
